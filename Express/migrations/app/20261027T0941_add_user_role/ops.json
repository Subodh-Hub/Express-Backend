  {
    "id": "column.public.User.role",
    "label": "Add column \"role\" to \"User\"",
    "operationClass": "additive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "column",
        "name": "role",
        "table": "User"
      }
    },
    "precheck": [
      {
        "description": "ensure column \"role\" is missing",
        "sql": "SELECT NOT EXISTS (SELECT 1 AS \"one\" FROM \"information_schema\".\"columns\" WHERE (\"table_schema\" = $1 AND \"table_name\" = $2 AND \"column_name\" = $3)) AS \"result\"",
        "params": [
          "public",
          "User",
          "role"
        ],
        "expectation": {
          "expects": "absent",
          "object": "column \"role\" on \"User\""
        }
      }
    ],
    "execute": [
      {
        "description": "add column \"role\"",
        "sql": "ALTER TABLE \"public\".\"User\" ADD COLUMN \"role\" \"Role\" DEFAULT 'USER'::\"Role\" NOT NULL"
      }
    ],
    "postcheck": [
      {
        "description": "verify column \"role\" exists",
        "sql": "SELECT EXISTS (SELECT 1 AS \"one\" FROM \"information_schema\".\"columns\" WHERE (\"table_schema\" = $1 AND \"table_name\" = $2 AND \"column_name\" = $3)) AS \"result\"",
        "params": [
          "public",
          "User",
          "role"
        ],
        "expectation": {
          "expects": "present",
          "object": "column \"role\" on \"User\""
        }
      },
      {
        "description": "verify column \"role\" has type \"Role\"",
        "sql": "SELECT EXISTS (SELECT 1 AS \"one\" FROM \"pg_attribute\" AS \"a\" WHERE (\"a\".\"attrelid\" = to_regclass($1) AND \"a\".\"attname\" = $2 AND \"a\".\"atttypid\" = to_regtype($3) AND NOT (\"a\".\"attisdropped\"))) AS \"result\"",
        "params": [
          "\"public\".\"User\"",
          "role",
          "\"Role\""
        ]
      },
      {
        "description": "verify column \"role\" is NOT NULL",
        "sql": "SELECT EXISTS (SELECT 1 AS \"one\" FROM \"information_schema\".\"columns\" WHERE (\"table_schema\" = $1 AND \"table_name\" = $2 AND \"column_name\" = $3 AND \"is_nullable\" = $4)) AS \"result\"",
        "params": [
          "public",
          "User",
          "role",
          "NO"
        ]
      }
    ]
  }
